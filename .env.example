# Copy to .env and fill in the four required keys below.
# Everything commented out has a working default.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Deepgram. Speech to text and turn detection (Flux). Not used for speech out.
# https://console.deepgram.com
DEEPGRAM_API_KEY=

# DeepSeek. The live conversation (navigation and spoken answers) and deck
# ingestion (per slide narration, deck title, intro and transitions).
# https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Cartesia. Speech out. Chosen over Deepgram Flux TTS because it sends a real
# in band cancel on interruption instead of reconnecting its websocket, and
# because it returns per word timestamps, which is what keeps the subtitles in
# step with the audio.
# https://play.cartesia.ai
CARTESIA_API_KEY=

# ---------------------------------------------------------------------------
# Optional but recommended
# ---------------------------------------------------------------------------

# Gemini. Vision narration for uploaded decks, so charts and diagrams are read
# from the rendered page rather than guessed at from the text layer. Without
# it, uploads still work and are narrated from extracted text alone.
#
# Free tier is capped per day per model, shared across every use of the key.
# Also read as lowercase gemini_api_key.
# https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

# ---------------------------------------------------------------------------
# Voices
# ---------------------------------------------------------------------------

# The six selectable presenters each carry their own Cartesia voice, defined in
# server/presenters.py. Nothing needs setting here for them to work.
#
# CARTESIA_VOICE_ID is a fallback only, for a presenter with no voice of its
# own. It deliberately does NOT override a presenter's voice: if it did, every
# presenter would sound identical and the picker would be decoration.
# CARTESIA_VOICE_ID=
# CARTESIA_MODEL=sonic-3

# token: stream text to Cartesia as the model emits it, which is lowest
# latency. sentence: wait for a full sentence first, which Cartesia's own
# service defaults to and which adds roughly 200 to 300 ms per sentence.
# CARTESIA_AGGREGATION_MODE=token

# Which presenter is selected by default in the picker.
# DEFAULT_PRESENTER=educator

# ---------------------------------------------------------------------------
# Speech recognition tuning
# ---------------------------------------------------------------------------

# DEEPGRAM_FLUX_STT_MODEL=flux-general-en

# How confident Flux must be before it calls the turn finished. Raising
# FLUX_EOT_THRESHOLD makes the agent slower to reply but less likely to cut in
# while someone is still thinking.
# FLUX_EOT_THRESHOLD=0.7
# FLUX_EAGER_EOT_THRESHOLD=0.5
# FLUX_EOT_TIMEOUT_MS=5000

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

HOST=0.0.0.0
PORT=7860

# Cross origin access, needed only in development where Vite serves the
# frontend from a different origin than the API. In production both come from
# one origin and this can be left empty to disable CORS entirely.
#
# Never set this to "*". Combined with credentials, browsers reject it, and
# where it does apply it lets any site drive this API with a visitor's cookies.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Pin outbound API calls to IPv4. On by default.
#
# Some networks run DNS64 and NAT64 and answer with a synthetic 64:ff9b::/96
# address ahead of the real IPv4 one. Where that gateway is unreachable, every
# request hangs until it times out, and httpx has no Happy Eyeballs fallback,
# so the OpenAI SDK spends its whole retry budget getting nowhere. The symptom
# is a session that connects normally and never speaks. Measured on one such
# network: 16.6 second timeouts became roughly 1.1 seconds.
#
# Set to 0 only on a genuinely IPv6 only network, where NAT64 is the only route
# to these IPv4 only APIs. See server/net.py.
# FORCE_IPV4=1

# ---------------------------------------------------------------------------
# PowerPoint upload
# ---------------------------------------------------------------------------

# PPTX and PPT are converted to PDF by headless LibreOffice, then follow the
# normal PDF path, so converted decks get real rendered slide images rather
# than a text only reconstruction.
#
# The Docker image installs LibreOffice. For local development install it and
# it will be found on PATH automatically. /api/health reports pptx_supported so
# the upload page can say up front whether .pptx will be accepted.
#
# Set this only if the binary lives somewhere unusual. A wrong path is treated
# as "not installed" rather than silently falling back to another copy.
# SOFFICE_BIN=C:\Program Files\LibreOffice\program\soffice.exe
# SOFFICE_TIMEOUT_S=180

# ---------------------------------------------------------------------------
# Alternative vision providers
# ---------------------------------------------------------------------------
# Used only if GEMINI_API_KEY is unset. Priority: Gemini, Bedrock, then any
# OpenAI compatible endpoint. DeepSeek is never a vision option: its platform
# API is text only and rejects image content outright.

# AWS Bedrock. Needs an inference profile id, not a bare model id. Model access
# is a per account AWS Marketplace subscription, and without a valid payment
# method every call fails with AccessDeniedException regardless of IAM policy.
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Any other OpenAI compatible vision endpoint.
# VISION_API_KEY=
# VISION_MODEL=
# VISION_BASE_URL=https://api.openai.com/v1
# Set to 0 if the endpoint does not support response_format=json_object.
# VISION_JSON_MODE=1

# ---------------------------------------------------------------------------
# Ingestion tuning
# ---------------------------------------------------------------------------

# DATA_DIR=./data
# MAX_SLIDES=40
# MAX_UPLOAD_MB=25
# NARRATION_CONCURRENCY=4
# RENDER_DPI=150
# Must cover hidden reasoning tokens as well as visible output.
# NARRATION_MAX_TOKENS=3000
# INSIGHTS_MAX_TOKENS=4000
# Longest transcript sent for analysis. Older turns are dropped first; the
# reported counts still reflect the whole session.
# INSIGHTS_MAX_TURNS=80
# TITLE_MAX_TOKENS=600
# SYNTHESIS_MAX_TOKENS=6000

# ---------------------------------------------------------------------------
# Advanced
# ---------------------------------------------------------------------------

# Point DeepSeek at a compatible gateway or a different model.
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-v4-flash

# Where the built frontend is served from. Set by the Docker image; only needed
# if you serve a build from an unusual path.
# WEB_DIST=./web/dist
